```{=html}
<% const h = items[0]; %>
<section class="hero<%= h.hero_image ? ' has-image' : '' %>"<% if (h.hero_image) { %> style="background-image: linear-gradient(rgba(14,51,48,.78), rgba(14,51,48,.86)), url('<%= String(h.hero_image).replace(/^\//, '') %>');"<% } %>>
  <div class="hero-inner">
    <div class="eyebrow"><%= h.eyebrow %></div>
    <h1><%= String(h.headline).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/\*(.+?)\*/g,'<em>$1</em>') %></h1>
    <p class="lede"><%= h.lede %></p>
    <div class="cta">
      <a class="btn-lab" href="research.html"><%= h.button_primary || "Explore our research" %></a>
      <a class="btn-lab ghost" href="join.html"><%= h.button_secondary || "Join the group" %></a>
    </div>
    <div class="sites"><% for (const s of (h.sites || [])) { %><span><%= s %></span><% } %></div>
  </div>
</section>
```

```{=html}
<% const h = items[0]; %>
<section class="hero<%= h.hero_image ? ' has-image' : '' %>"<% if (h.hero_image) { %> style="background-image: linear-gradient(rgba(14,51,48,.78), rgba(14,51,48,.86)), url('<%= String(h.hero_image).replace(/^\//, '') %>');"<% } %>>
  <div class="hero-inner">
    <div class="eyebrow"><%= h.eyebrow %></div>
    <h1><%= String(h.headline).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/\*(.+?)\*/g,'<em>$1</em>') %></h1>
    <p class="lede"><%= h.lede %></p>
    <div class="cta">
      <a class="btn-lab" href="research.html"><%= h.button_primary || "Explore our research" %></a>
      <a class="btn-lab ghost" href="join.html"><%= h.button_secondary || "Join the group" %></a>
    </div>
    <div class="sites"><% for (const s of (h.sites || [])) { %><span><%= s %></span><% } %></div>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <div class="section-label"><%= h.what_label %></div>
    <h2><%= h.what_title %></h2>
    <p class="intro"><%= h.what_intro %></p>
    <div class="pillars">
    <% for (const p of (h.pillars || [])) { %>
      <div class="pillar"><h3><%= p.name %><span>.</span></h3><p><%= p.text %></p></div>
    <% } %>
    </div>
  </div>
</section>

<section class="band dark">
  <div class="wrap">
    <div class="section-label"><%= h.numbers_label %></div>
    <h2><%= h.numbers_title %></h2>
    <div class="stats">
    <% for (const s of (h.stats || [])) { %>
      <div class="stat"><b><%= s.value %></b><span><%= s.label %></span></div>
    <% } %>
    </div>
  </div>
</section>

<section class="band story">
  <div class="wrap">
    <div class="section-label"><%= h.story_label %></div>
    <h2><%= h.story_title %></h2>
    <% if (h.video) { %><div class="video"><iframe src="<%= h.video %>" title="<%= h.story_title %>" loading="lazy" allowfullscreen></iframe></div><% } %>
    <ol class="beats">
    <% for (const b of (h.story || [])) { %>
      <li><span class="beat-label"><%= b.label %></span><p><%= b.text %></p></li>
    <% } %>
    </ol>
  </div>
</section>
```
